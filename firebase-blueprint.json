{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user profile and playback preferences synchronized across devices.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "theme": {
          "type": "string",
          "enum": ["light", "dark", "auto"]
        },
        "speechRate": {
          "type": "number"
        },
        "preferredVoice": {
          "type": "string",
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "theme", "speechRate", "createdAt", "updatedAt"]
    },
    "Story": {
      "title": "Story",
      "description": "Audiobook or text story metadata owned by a user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "author": {
          "type": "string",
          "maxLength": 120
        },
        "cover": {
          "type": "string",
          "maxLength": 250000
        },
        "chapterCount": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "title", "chapterCount", "createdAt", "updatedAt"]
    },
    "Chapter": {
      "title": "Chapter",
      "description": "Individual story chapter text stored for on-demand download and cross-device sync.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "storyId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "index": {
          "type": "integer"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600000
        },
        "charCount": {
          "type": "integer"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "storyId", "index", "title", "text", "charCount", "updatedAt"]
    },
    "ListeningProgress": {
      "title": "ListeningProgress",
      "description": "Latest listening position for a story synchronized across devices.",
      "type": "object",
      "properties": {
        "storyId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chapterIndex": {
          "type": "integer"
        },
        "chunkIndex": {
          "type": "integer"
        },
        "audioTime": {
          "type": "number"
        },
        "totalChunks": {
          "type": "integer"
        },
        "chapterTitle": {
          "type": "string",
          "maxLength": 200
        },
        "deviceName": {
          "type": "string",
          "maxLength": 120
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["storyId", "ownerId", "chapterIndex", "chunkIndex", "audioTime", "totalChunks", "updatedAt"]
    },
    "Playlist": {
      "title": "Playlist",
      "description": "Custom user playlist referencing story chapters.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "items": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "name", "items", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user settings and root document for user-owned subcollections."
    },
    "/users/{userId}/stories/{storyId}": {
      "schema": { "$ref": "#/entities/Story" },
      "description": "Stories created or synced by the user."
    },
    "/users/{userId}/stories/{storyId}/chapters/{chapterId}": {
      "schema": { "$ref": "#/entities/Chapter" },
      "description": "Chapters belonging to a specific story."
    },
    "/users/{userId}/progress/{storyId}": {
      "schema": { "$ref": "#/entities/ListeningProgress" },
      "description": "Per-story listening progress synchronized across devices."
    },
    "/users/{userId}/playlists/{playlistId}": {
      "schema": { "$ref": "#/entities/Playlist" },
      "description": "Custom listening playlists created by the user."
    }
  }
}
